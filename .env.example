# Load Test Configuration
# Copy this file to .env and fill in your secrets
# NEVER commit .env to git!

# Token to bypass rate limiting (matches LOAD_TEST_TOKEN on server)
LOAD_TEST_TOKEN=your-secret-token-here

# Example: Generate a secure random token with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Raw ProviderApiKey for the mobile_checkout scenario (--scenario mobile_checkout).
# Generate via Rails console against the target environment:
#   ProviderApiKey.generate(provider: Provider.find_by(slug: "pretend-school"), label: "load-test")
# The raw key is only shown once at generation time.
MOBILE_PROVIDER_API_KEY=your-provider-api-key-here
